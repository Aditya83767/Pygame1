import tkinter as tk
from tkinter import messagebox

root = tk.Tk()
root.title("Restaurant App")
root.geometry("300x400")
root.config(bg="lightgreen")

def place_order():
    fries = int(fries_entry.get() or 0)
    burger = int(burger_entry.get() or 0)
    drinks = int(drinks_entry.get() or 0)

    total = fries * 2 + burger * 3 + drinks * 1

    messagebox.showinfo("Bill", f"Total Cost = ${total}")


tk.Label(root, text="Restaurant Menu",
         font=("Arial", 16, "bold"),
         bg="lightgreen").pack(pady=10)

tk.Label(root, text="Fries ($2)", bg="lightgreen").pack()
fries_entry = tk.Entry(root)
fries_entry.pack(pady=5)

tk.Label(root, text="Burger ($3)", bg="lightgreen").pack()
burger_entry = tk.Entry(root)
burger_entry.pack(pady=5)

tk.Label(root, text="Drinks ($1)", bg="lightgreen").pack()
drinks_entry = tk.Entry(root)
drinks_entry.pack(pady=5)

tk.Button(
    root,
    text="Place Order",
    command=place_order,
    bg="orange"
).pack(pady=15)

root.mainloop()
